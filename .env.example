# Chat Integration — Environment

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Neon Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 32+ char session secret
SESSION_SECRET=change_me_to_a_long_random_string

# 32-byte key as 64 hex chars (openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Twitch Developer Application
# Redirect URL: {APP_URL}/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google Cloud OAuth (YouTube Data API v3)
# Redirect URL: {APP_URL}/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kick Developer Application
# Redirect URL: {APP_URL}/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
